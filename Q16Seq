#!/usr/bin/env bash
# Q16Seq (RT-RubyRed) launcher: activates the qiime2 environment and starts the watcher.
TOOL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -z "$CONDA_BASE" ]; then
    for d in "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3"; do
        [ -d "$d" ] && CONDA_BASE="$d" && break
    done
fi
ENV_DIR="${Q16SEQ_ENV:-$CONDA_BASE/envs/qiime2}"
if [ -x "$ENV_DIR/bin/python" ]; then
    # Activate the env directly: PATH + QIIME 2's own activation hook only. This avoids
    # `conda activate`, whose r-base hook (`R CMD javareconf`) can hang for minutes.
    export CONDA_PREFIX="$ENV_DIR" CONDA_DEFAULT_ENV="$(basename "$ENV_DIR")" PATH="$ENV_DIR/bin:$PATH"
    export MPLBACKEND=Agg R_LIBS_USER="$ENV_DIR/lib/R/library/"
    # shellcheck disable=SC1091
    [ -f "$ENV_DIR/etc/conda/activate.d/00_activate_qiime2_envs.sh" ] && \
        . "$ENV_DIR/etc/conda/activate.d/00_activate_qiime2_envs.sh" >/dev/null 2>&1
else
    # shellcheck disable=SC1091
    source "$CONDA_BASE/etc/profile.d/conda.sh" 2>/dev/null || { echo "conda not found (set CONDA_BASE or Q16SEQ_ENV)" >&2; exit 1; }
    conda activate qiime2 || { echo "cannot activate the qiime2 conda env" >&2; exit 1; }
fi
export LC_ALL=C.UTF-8 LANG=C.UTF-8 PYTHONUNBUFFERED=1
exec python "$TOOL_DIR/rt_rubyred.py" "$@"
