#!/usr/bin/env bash
# Q16Seq (RT-RubyRed) launcher: activates the qiime2 environment and starts the watcher.
TOOL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -z "$CONDA_BASE" ]; then
    for d in "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3"; do
        [ -f "$d/etc/profile.d/conda.sh" ] && CONDA_BASE="$d" && break
    done
fi
# shellcheck disable=SC1091
source "$CONDA_BASE/etc/profile.d/conda.sh" 2>/dev/null || { echo "conda not found (set CONDA_BASE)" >&2; exit 1; }
conda activate qiime2 || { echo "cannot activate the qiime2 conda env" >&2; exit 1; }
export LC_ALL=C.UTF-8 LANG=C.UTF-8 PYTHONUNBUFFERED=1
exec python "$TOOL_DIR/rt_rubyred.py" "$@"
